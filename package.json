{
  "name": "workbench-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared UI kit (plain CSS + React components) vendored into applications",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config gallery/vite.config.ts",
    "build:gallery": "vite build --config gallery/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.src.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.3.0",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "28.1.0",
    "prettier": "3.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
